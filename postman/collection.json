{
  "info": {
    "name": "Warehouse Stock Tracker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sku\", \"API-\" + pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 24));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Health: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Version",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Version: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().name).to.eql(\"Warehouse Stock Tracker\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List items",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"List items: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Add item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"{{sku}}\", \"name\": \"API test item\", \"quantity\": 10, \"reorder_level\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Add item: status\", () => pm.response.to.have.status(201));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().quantity).to.eql(10); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\"sku\": \"{{sku}}\", \"name\": \"Duplicate\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Duplicate item: status\", () => pm.response.to.have.status(409));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Receive",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{sku}}/receive",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Receive: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().quantity).to.eql(15); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Issue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{sku}}/issue",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 11}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Issue: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().quantity).to.eql(4); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Insufficient stock",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{sku}}/issue",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Insufficient stock: status\", () => pm.response.to.have.status(409));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().error).to.eql(\"insufficient stock\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Stock unchanged",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Stock unchanged: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().find(i => i.sku === pm.collectionVariables.get(\"sku\")).quantity).to.eql(4); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Low stock",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/alerts/low-stock"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Low stock: status\", () => pm.response.to.have.status(200));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().some(i => i.sku === pm.collectionVariables.get(\"sku\"))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid quantity",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{sku}}/receive",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": true}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid quantity: status\", () => pm.response.to.have.status(400));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown SKU",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/MISSING-{{$guid}}/receive",
        "body": {
          "mode": "raw",
          "raw": "{\"quantity\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Unknown SKU: status\", () => pm.response.to.have.status(404));",
              "pm.test(\"Security headers\", () => pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
              "pm.test(\"Response content\", () => { pm.expect(pm.response.json().error).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    }
  ]
}
